#!/usr/bin/env bash
# Manage a Solis Monitor installed by install.sh (it lives in /opt/solis-monitor, with a link at
# /usr/local/bin/solis-monitor). Updates only ever go to tagged releases, never to unreleased code.
#
#   solis-monitor status                 version, containers, latest reading
#   solis-monitor update [--version vX]  install the latest release (or the one named); rolls back on failure
#   solis-monitor auto-update on|off     check for a new release every night (off by default)
#   solis-monitor logs [service]         follow the logs (poller, web or influxdb)
#   solis-monitor edit                   open .env in your editor, then apply the changes
#   solis-monitor apply [--force]        apply a .env you edited by hand (restarts only what changed)
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
cd "$DIR"
SELF="$DIR/solis-monitor"
# .env is readable by root only (it holds the passwords) and Docker needs root: ask for sudo ourselves.
# Never loops: only a non-root user re-runs itself, once (SOLIS_ELEVATED), and root without a .env just stops.
if [[ ! -r "$DIR/.env" ]]; then
  if [[ $EUID -eq 0 || -n "${SOLIS_ELEVATED:-}" ]]; then
    echo "solis-monitor: cannot read $DIR/.env (is this a Solis Monitor install folder?)" >&2; exit 1
  fi
  command -v sudo >/dev/null || { echo "solis-monitor: needs root (run it as root, or install sudo)" >&2; exit 1; }
  exec sudo env SOLIS_ELEVATED=1 "SOLIS_EDITOR=${VISUAL:-${EDITOR:-}}" "$SELF" "$@"      # sudo drops EDITOR, so pass it along
fi

env_value() { grep -E "^$1=" .env 2>/dev/null | sed -n 1p | cut -d= -f2- | sed 's/[[:space:]]#.*//; s/[[:space:]]*$//' || true; }
set_env() {          # set_env NAME VALUE: replace the NAME= line, or add it
  if grep -qE "^$1=" .env; then sed -i "s|^$1=.*|$1=$2|" .env; else echo "$1=$2" >> .env; fi
}
die() { echo "solis-monitor: $*" >&2; exit 1; }
as_root() { if [[ $EUID -eq 0 ]]; then "$@"; else sudo "$@"; fi; }
compose() { docker compose "$@"; }

REPO="$(env_value SOLIS_REPO)"
RAW_BASE="${SOLIS_RAW_BASE:-https://raw.githubusercontent.com/${REPO}}"
API_BASE="${SOLIS_API_BASE:-https://api.github.com/repos/${REPO}}"

notify() {           # Telegram notice if the bot is set up in .env
  local token chat site
  token=$(env_value TELEGRAM_BOT_TOKEN); chat=$(env_value TELEGRAM_CHAT_ID); site=$(env_value SITE_NAME)
  [[ -n "$token" && -n "$chat" ]] || return 0
  curl -s -m 15 -o /dev/null "https://api.telegram.org/bot${token}/sendMessage" \
       --data-urlencode "chat_id=${chat}" --data-urlencode "text=${site:+[$site] }$1" || true
}

latest_release() {
  local json
  json=$(curl -fsS -m 20 "$API_BASE/releases/latest") || die "could not reach GitHub to look for a release"
  printf '%s' "$json" | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | sed -n 1p
}

cmd_status() {
  echo "Version:   $(env_value SOLIS_VERSION)  (repo $REPO)"
  echo "Dashboard: http://$(hostname -I | awk '{print $1}'):$(env_value WEB_PORT | sed 's/^$/8088/')"
  echo "Inverter:  $(env_value INVERTER_HOST || true)"
  echo "Updates:   $(systemctl is-enabled solis-monitor-update.timer 2>/dev/null | sed 's/^enabled$/automatic, nightly/; s/^disabled$/manual (solis-monitor update)/' || true)"
  compose ps --format 'table {{.Name}}\t{{.Status}}'
  echo "--- poller, last lines ---"
  compose logs --tail 5 poller 2>&1 || true
}

cmd_update() {
  local target=""
  while (($#)); do
    case "$1" in
      --version) target="${2:?--version needs a tag, e.g. v1.2.0}"; shift 2 ;;
      --auto) shift ;;                       # from the nightly timer; same as by hand
      *) die "unknown option $1" ;;
    esac
  done
  [[ -n "$REPO" ]] || die "SOLIS_REPO is missing from .env"
  exec 9>/tmp/solis-monitor-update.lock
  flock -n 9 || { echo "another update is running"; exit 0; }

  local current explicit="$target"
  current="$(env_value SOLIS_VERSION)"
  [[ -n "$target" ]] || target="$(latest_release)"
  [[ -n "$target" ]] || die "no release found"
  if [[ "$target" == "$current" ]]; then echo "Already on $current."; return 0; fi
  if [[ -z "$explicit" && "$(printf '%s\n%s\n' "$current" "$target" | sort -V | sed -n 2p)" == "$current" ]]; then
    echo "Latest release $target is not newer than $current."; return 0      # never downgrade by itself
  fi

  echo "Updating $current -> $target"
  tmp="$(mktemp -d)"; trap 'rm -rf "${tmp:-}"' EXIT
  curl -fsS -m 60 -o "$tmp/docker-compose.yml" "$RAW_BASE/$target/docker-compose.yml" || die "could not download $target"
  curl -fsS -m 60 -o "$tmp/solis-monitor" "$RAW_BASE/$target/deploy/solis-monitor" || die "could not download $target"

  cp docker-compose.yml docker-compose.yml.prev
  install -m 644 "$tmp/docker-compose.yml" docker-compose.yml
  set_env SOLIS_VERSION "$target"

  # Only our own images: the database image is not refreshed behind your back (that restart took ~2 minutes on a Pi).
  # A release that names another database version still gets it, because `up` pulls what is missing.
  if ! compose pull --quiet poller web; then
    echo "Could not download the images for $target; staying on $current." >&2
    restore "$current"; return 1
  fi
  compose up -d --remove-orphans
  if wait_healthy; then
    install -m 755 "$tmp/solis-monitor" "$SELF.new" && mv "$SELF.new" "$SELF"      # mv: the running copy is not overwritten in place
    echo "Updated to $target."
    notify "🚀 Solis Monitor updated to $target"
  else
    echo "$target did not start properly; going back to $current." >&2
    restore "$current"
    compose up -d --remove-orphans
    notify "❌ Solis Monitor update to $target failed; still on $current"
    return 1
  fi
}

restore() {          # put the previous compose file and version back
  [[ -f docker-compose.yml.prev ]] && mv docker-compose.yml.prev docker-compose.yml
  set_env SOLIS_VERSION "$1"
}

wait_healthy() {     # the web container's healthcheck passes and the poller stays up
  local _
  for _ in $(seq 1 "${SOLIS_HEALTH_TRIES:-40}"); do
    if [[ "$(docker inspect -f '{{.State.Health.Status}}' solis-web 2>/dev/null)" == "healthy" ]] \
       && [[ "$(docker inspect -f '{{.State.Running}}' solis-poller 2>/dev/null)" == "true" ]]; then
      sleep "${SOLIS_SETTLE_S:-10}"             # a crashing poller restarts within seconds
      [[ "$(docker inspect -f '{{.State.Running}}' solis-poller 2>/dev/null)" == "true" ]] && return 0
    fi
    sleep "${SOLIS_HEALTH_STEP:-5}"
  done
  return 1
}

# Settings the database only reads on its very first start: changing them in .env afterwards locks the
# poller and the dashboard out of InfluxDB. Compare .env with what the running container was created with.
locked_changes() {
  local pair name init have want changed=""
  for pair in INFLUX_TOKEN:ADMIN_TOKEN INFLUX_PASSWORD:PASSWORD INFLUX_USER:USERNAME INFLUX_ORG:ORG INFLUX_BUCKET:BUCKET; do
    name="${pair%%:*}"; init="DOCKER_INFLUXDB_INIT_${pair##*:}"
    have=$(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' solis-influxdb 2>/dev/null | sed -n "s/^${init}=//p" | sed -n 1p)
    want=$(env_value "$name")
    if [[ -n "$have" && "$have" != "$want" ]]; then changed="$changed $name"; fi
  done
  echo "${changed# }"
}

cmd_apply() {
  local force=""
  [[ "${1:-}" == "--force" ]] && force=1
  compose config -q 2>&1 || die ".env or docker-compose.yml has an error (see above); nothing was changed"
  local locked; locked="$(locked_changes)"
  if [[ -n "$locked" && -z "$force" ]]; then
    die "$locked only count on the database's very first start. Changing them now would lock the poller and the dashboard out of InfluxDB.
Put the old value(s) back in .env, or rotate the token properly (docs/advanced.md in the repository), or run with --force if you know what you are doing."
  fi
  chmod 600 .env
  compose up -d --remove-orphans
  if wait_healthy; then
    echo "Applied: the dashboard is up and the poller is running."
  else
    echo "Applied, but the dashboard or the poller is not healthy yet. Look at: solis-monitor logs poller" >&2
    return 1
  fi
}

cmd_edit() {
  local editor="${SOLIS_EDITOR:-${VISUAL:-${EDITOR:-}}}" ans
  if [[ -z "$editor" ]]; then
    for editor in editor nano vi; do command -v "$editor" >/dev/null && break; done
  fi
  command -v "${editor%% *}" >/dev/null || die "no text editor found; set EDITOR (for example: EDITOR=nano solis-monitor edit)"
  backup="$(mktemp)"; cp .env "$backup"; trap 'rm -f "${backup:-}"' EXIT      # (global: the trap runs after this function)
  while :; do
    # shellcheck disable=SC2086   # the editor may carry options, e.g. "code --wait"
    $editor .env
    if cmp -s .env "$backup"; then echo "No changes."; return 0; fi
    if compose config -q 2>/dev/null; then break; fi
    compose config -q 2>&1 | sed -n 1,5p >&2 || true      # pipefail: the failing compose call is the point
    read -rp "That file has an error. Edit again? [Y/n] (n puts the old file back) " ans
    if [[ "${ans:-y}" == [nN]* ]]; then cp "$backup" .env; echo "Old .env restored."; return 1; fi
  done
  chmod 600 .env
  read -rp "Apply the changes now? [Y/n] " ans
  if [[ "${ans:-y}" == [nN]* ]]; then echo "Saved. Apply later with: solis-monitor apply"; return 0; fi
  cmd_apply || { read -rp "Put the previous .env back? [y/N] " ans; if [[ "${ans:-n}" == [yY]* ]]; then cp "$backup" .env && cmd_apply; fi; return 1; }
}

cmd_auto_update() {
  case "${1:-}" in
    on)
      as_root tee /etc/systemd/system/solis-monitor-update.service >/dev/null <<UNIT
[Unit]
Description=Update Solis Monitor to the latest release
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=$SELF update --auto
UNIT
      as_root tee /etc/systemd/system/solis-monitor-update.timer >/dev/null <<UNIT
[Unit]
Description=Look for a new Solis Monitor release every night

[Timer]
OnCalendar=*-*-* 04:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
UNIT
      as_root systemctl daemon-reload
      as_root systemctl enable --now solis-monitor-update.timer
      echo "Automatic updates are on: each night the latest tagged release is installed." ;;
    off)
      as_root systemctl disable --now solis-monitor-update.timer 2>/dev/null || true
      echo "Automatic updates are off. Update by hand with: solis-monitor update" ;;
    *) die "usage: solis-monitor auto-update on|off" ;;
  esac
}

case "${1:-}" in
  status) cmd_status ;;
  update) shift; cmd_update "$@" ;;
  auto-update) shift; cmd_auto_update "${1:-}" ;;
  logs) shift; compose logs -f --tail 100 "$@" ;;
  apply) shift; cmd_apply "${1:-}" ;;
  edit) cmd_edit ;;
  version) env_value SOLIS_VERSION ;;
  ""|-h|--help|help) sed -n '2,10p' "$SELF" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command '$1' (try: solis-monitor help)" ;;
esac
