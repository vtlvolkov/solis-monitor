#!/usr/bin/env bash
# Manage a Solis Monitor installed by install.sh (it lives in /opt/solis-monitor, with a link at
# /usr/local/bin/solis-monitor). Updates only ever go to tagged releases, never to unreleased code.
#
#   solis-monitor status                 version, containers, latest reading
#   solis-monitor update [--version vX]  install the latest release (or the one named); rolls back on failure
#   solis-monitor auto-update on|off     check for a new release every night (off by default)
#   solis-monitor logs [-f] [service]    recent log lines (poller, web or influxdb); -f keeps following
#   solis-monitor dashboard-updates on|off  let the dashboard's Settings page update this install (off by default for source builds)
#   solis-monitor edit                   open .env in your editor, then apply the changes
#   solis-monitor apply [--force]        apply a .env you edited by hand (restarts only what changed)
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
cd "$DIR"
SELF="$DIR/solis-monitor"
# .env is readable by root only (it holds the passwords) and Docker needs root: ask for sudo ourselves.
# Never loops: only a non-root user re-runs itself, once (SOLIS_ELEVATED), and root without a .env just stops.
if [[ ! -r "$DIR/.env" ]]; then
  if [[ $EUID -eq 0 || -n "${SOLIS_ELEVATED:-}" ]]; then
    echo "solis-monitor: cannot read $DIR/.env (is this a Solis Monitor install folder?)" >&2; exit 1
  fi
  command -v sudo >/dev/null || { echo "solis-monitor: needs root (run it as root, or install sudo)" >&2; exit 1; }
  exec sudo env SOLIS_ELEVATED=1 "SOLIS_EDITOR=${VISUAL:-${EDITOR:-}}" "$SELF" "$@"      # sudo drops EDITOR, so pass it along
fi

env_value() { grep -E "^$1=" .env 2>/dev/null | sed -n 1p | cut -d= -f2- | sed 's/[[:space:]]#.*//; s/[[:space:]]*$//' || true; }
set_env() {          # set_env NAME VALUE: replace the NAME= line, or add it
  if grep -qE "^$1=" .env; then sed -i "s|^$1=.*|$1=$2|" .env; else echo "$1=$2" >> .env; fi
}
die() { echo "solis-monitor: $*" >&2; exit 1; }
as_root() {         # as_root [-u USER] command...
  local who=()
  if [[ "${1:-}" == -u ]]; then who=(-u "$2"); shift 2; fi
  if [[ $EUID -eq 0 ]]; then
    if ((${#who[@]})); then sudo "${who[@]}" "$@"; else "$@"; fi
  else sudo "${who[@]}" "$@"; fi
}
compose() { docker compose "$@"; }
CTL="$DIR/control"          # shared with the web container: the dashboard's update requests and our progress
ensure_ctl() { [[ -d "$CTL" ]] || mkdir -p "$CTL" 2>/dev/null || true; }
now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }
json_text() { printf '%s' "$1" | tr -d '"\\\n\r' | cut -c1-250; }
REPORT=""; REPORT_DONE=""; REPORT_FROM=""; REPORT_TO=""; REPORT_STARTED=""; REPORT_PERCENT=0
report() {           # report STATE MESSAGE [PERCENT]: progress for the dashboard (only when the dashboard asked for this update)
  [[ -n "$REPORT" ]] || return 0
  local finished=""
  [[ -z "${3:-}" ]] || REPORT_PERCENT="$3"
  [[ "$1" == running ]] || { finished="$(now_iso)"; REPORT_DONE=1; }
  [[ "$1" != ok ]] || REPORT_PERCENT=100
  printf '{"state":"%s","from":"%s","to":"%s","message":"%s","percent":%s,"started":"%s","finished":"%s"}\n' \
    "$1" "$(json_text "$REPORT_FROM")" "$(json_text "$REPORT_TO")" "$(json_text "$2")" "$REPORT_PERCENT" "$REPORT_STARTED" "$finished" \
    > "$CTL/update-status.json.tmp" 2>/dev/null && mv "$CTL/update-status.json.tmp" "$CTL/update-status.json" 2>/dev/null || true
}
finish_report() {    # whatever stopped the update (die, a signal), the dashboard must not wait forever
  [[ -n "$REPORT" && -z "$REPORT_DONE" ]] && report failed "The update stopped before it finished. See: solis-monitor logs" || true
}
refresh_bridge() {   # keep bridge.json (written by `dashboard-updates on`) in step with the installed version
  [[ -f "$CTL/bridge.json" ]] || return 0
  printf '{"enabled":true,"version":"%s","updated":"%s"}\n' "$(json_text "$(env_value SOLIS_VERSION)")" "$(now_iso)" \
    > "$CTL/bridge.json.tmp" 2>/dev/null && mv "$CTL/bridge.json.tmp" "$CTL/bridge.json" 2>/dev/null || true
}

REPO="$(env_value SOLIS_REPO)"
RAW_BASE="${SOLIS_RAW_BASE:-https://raw.githubusercontent.com/${REPO}}"
API_BASE="${SOLIS_API_BASE:-https://api.github.com/repos/${REPO}}"

notify() {           # Telegram notice if the bot is set up in .env
  local token chat site
  token=$(env_value TELEGRAM_BOT_TOKEN); chat=$(env_value TELEGRAM_CHAT_ID); site=$(env_value SITE_NAME)
  [[ -n "$token" && -n "$chat" ]] || return 0
  curl -s -m 15 -o /dev/null "https://api.telegram.org/bot${token}/sendMessage" \
       --data-urlencode "chat_id=${chat}" --data-urlencode "text=${site:+[$site] }$1" || true
}

latest_release() {
  local json
  json=$(curl -fsS -m 20 "$API_BASE/releases/latest") || die "could not look up the latest release on GitHub. If you or other devices on your network asked a lot just now, GitHub's anonymous limit (60 requests an hour per network) may be used up: try again later, or name the version: solis-monitor update --version vX.Y.Z"
  printf '%s' "$json" | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | sed -n 1p
}

cmd_status() {
  echo "Version:   $(env_value SOLIS_VERSION)  (repo $REPO)"
  echo "Dashboard: http://$(hostname -I | awk '{print $1}'):$(env_value WEB_PORT | sed 's/^$/8088/')"
  # An address saved on the dashboard (Settings -> General) wins over INVERTER_HOST in .env.
  local saved env_host
  saved="$(compose exec -T poller cat /data/inverter.json 2>/dev/null | sed -n 's/.*"host": *"\([^"]*\)".*/\1/p' | sed -n 1p || true)"
  env_host="$(env_value INVERTER_HOST || true)"
  if [[ -n "$saved" ]]; then echo "Inverter:  $saved  (saved on the dashboard; .env has ${env_host:-nothing})"
  else echo "Inverter:  ${env_host:-not set yet (enter it on the dashboard: Settings -> General)}"; fi
  if [[ -f "$CTL/bridge.json" ]]; then echo "Dashboard:  can update itself (Settings -> System -> Software)"; else echo "Dashboard:  cannot update itself (solis-monitor dashboard-updates on)"; fi
  if [[ "$(systemctl is-enabled solis-monitor-update.timer 2>/dev/null || true)" == enabled ]]; then
    echo "Updates:   automatic, nightly (solis-monitor auto-update off to stop)"
  else
    echo "Updates:   manual (solis-monitor update)"
  fi
  compose ps --format 'table {{.Name}}\t{{.Status}}'
  echo "--- poller, last lines ---"
  compose logs --tail 5 poller 2>&1 || true
}

cmd_update() {
  local target=""
  while (($#)); do
    case "$1" in
      --version) target="${2:?--version needs a tag, e.g. v1.2.0}"; shift 2 ;;
      --auto) shift ;;                       # from the nightly timer; same as by hand
      --from-dashboard) REPORT=1; shift ;;   # started by the dashboard's request file; report progress back
      *) die "unknown option $1" ;;
    esac
  done
  [[ -n "$REPO" ]] || die "SOLIS_REPO is missing from .env"
  tmp=""; trap 'rm -rf "${tmp:-}"; finish_report' EXIT
  if [[ -n "$REPORT" ]]; then
    # The path unit also fires when we delete the request below: with no request there is nothing to do.
    [[ -e "$CTL/update-request" ]] || { REPORT=""; return 0; }
    rm -f "$CTL/update-request" || die "cannot remove $CTL/update-request (is the folder owned by the user running this?)"
    REPORT_STARTED="$(now_iso)"
  fi
  exec 9>/tmp/solis-monitor-update.lock
  flock -n 9 || { echo "another update is running"; REPORT=""; exit 0; }

  local current explicit="$target"
  current="$(env_value SOLIS_VERSION)"; REPORT_FROM="$current"
  report running "Looking for the newest release" 5
  [[ -n "$target" ]] || target="$(latest_release)"
  [[ -n "$target" ]] || die "no release found"
  REPORT_TO="$target"
  if [[ "$target" == "$current" ]]; then echo "Already on $current."; report ok "Already on $current"; return 0; fi
  if [[ -z "$explicit" && "$(printf '%s\n%s\n' "$current" "$target" | sort -V | sed -n 2p)" == "$current" ]]; then
    echo "Latest release $target is not newer than $current."; report ok "Already on the newest release ($current)"; return 0      # never downgrade by itself
  fi

  echo "Updating $current -> $target"
  report running "Downloading the files of $target" 15
  tmp="$(mktemp -d)"
  curl -fsS -m 60 -o "$tmp/docker-compose.yml" "$RAW_BASE/$target/docker-compose.yml" || die "could not download $target"
  curl -fsS -m 60 -o "$tmp/solis-monitor" "$RAW_BASE/$target/deploy/solis-monitor" || die "could not download $target"

  cp docker-compose.yml docker-compose.yml.prev
  install -m 644 "$tmp/docker-compose.yml" docker-compose.yml
  set_env SOLIS_VERSION "$target"

  # Only our own images: the database image is not refreshed behind your back (that restart took ~2 minutes on a Pi).
  # A release that names another database version still gets it, because `up` pulls what is missing.
  # One image at a time, so the dashboard's progress bar has something real to show on a slow link.
  local image pct=20
  for image in poller web; do
    report running "Downloading the $image image" "$pct"
    if ! compose pull --quiet "$image"; then
      echo "Could not download the images for $target; staying on $current." >&2
      restore "$current"; report failed "Could not download the images for $target. Still on $current."; return 1
    fi
    pct=$((pct + 25))
  done
  report running "Restarting with $target" 72
  ensure_ctl
  compose up -d --remove-orphans
  if wait_healthy; then
    install -m 755 "$tmp/solis-monitor" "$SELF.new" && mv "$SELF.new" "$SELF"      # mv: the running copy is not overwritten in place
    echo "Updated to $target."
    refresh_bridge; report ok "Updated to $target"
    notify "🚀 Solis Monitor updated to $target"
  else
    echo "$target did not start properly; going back to $current." >&2
    restore "$current"
    compose up -d --remove-orphans
    report rolled_back "$target did not start properly, so $current was restored."
    notify "❌ Solis Monitor update to $target failed; still on $current"
    return 1
  fi
}

restore() {          # put the previous compose file and version back
  [[ -f docker-compose.yml.prev ]] && mv docker-compose.yml.prev docker-compose.yml
  set_env SOLIS_VERSION "$1"
}

wait_healthy() {     # the web container's healthcheck passes and the poller stays up
  local _ n=0 tries="${SOLIS_HEALTH_TRIES:-40}"
  for _ in $(seq 1 "$tries"); do
    n=$((n + 1))
    report running "Waiting for the new version to start" $((75 + 23 * n / tries))      # no-op unless the dashboard asked
    if [[ "$(docker inspect -f '{{.State.Health.Status}}' solis-web 2>/dev/null)" == "healthy" ]] \
       && [[ "$(docker inspect -f '{{.State.Running}}' solis-poller 2>/dev/null)" == "true" ]]; then
      sleep "${SOLIS_SETTLE_S:-10}"             # a crashing poller restarts within seconds
      [[ "$(docker inspect -f '{{.State.Running}}' solis-poller 2>/dev/null)" == "true" ]] && return 0
    fi
    sleep "${SOLIS_HEALTH_STEP:-5}"
  done
  return 1
}

# Settings the database only reads on its very first start: changing them in .env afterwards locks the
# poller and the dashboard out of InfluxDB. Compare .env with what the running container was created with.
locked_changes() {
  local pair name init have want changed=""
  for pair in INFLUX_TOKEN:ADMIN_TOKEN INFLUX_PASSWORD:PASSWORD INFLUX_USER:USERNAME INFLUX_ORG:ORG INFLUX_BUCKET:BUCKET; do
    name="${pair%%:*}"; init="DOCKER_INFLUXDB_INIT_${pair##*:}"
    have=$(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' solis-influxdb 2>/dev/null | sed -n "s/^${init}=//p" | sed -n 1p)
    want=$(env_value "$name")
    if [[ -n "$have" && "$have" != "$want" ]]; then changed="$changed $name"; fi
  done
  echo "${changed# }"
}

cmd_apply() {
  local force=""
  [[ "${1:-}" == "--force" ]] && force=1
  compose config -q 2>&1 || die ".env or docker-compose.yml has an error (see above); nothing was changed"
  local locked; locked="$(locked_changes)"
  if [[ -n "$locked" && -z "$force" ]]; then
    die "$locked only count on the database's very first start. Changing them now would lock the poller and the dashboard out of InfluxDB.
Put the old value(s) back in .env, or rotate the token properly (docs/advanced.md in the repository), or run with --force if you know what you are doing."
  fi
  chmod 600 .env
  ensure_ctl
  compose up -d --remove-orphans
  if wait_healthy; then
    echo "Applied: the dashboard is up and the poller is running."
  else
    echo "Applied, but the dashboard or the poller is not healthy yet. Look at: solis-monitor logs poller" >&2
    return 1
  fi
}

cmd_edit() {
  local editor="${SOLIS_EDITOR:-${VISUAL:-${EDITOR:-}}}" ans
  if [[ -z "$editor" ]]; then
    for editor in editor nano vi; do command -v "$editor" >/dev/null && break; done
  fi
  command -v "${editor%% *}" >/dev/null || die "no text editor found; set EDITOR (for example: EDITOR=nano solis-monitor edit)"
  backup="$(mktemp)"; cp .env "$backup"; trap 'rm -f "${backup:-}"' EXIT      # (global: the trap runs after this function)
  while :; do
    # shellcheck disable=SC2086   # the editor may carry options, e.g. "code --wait"
    $editor .env
    if cmp -s .env "$backup"; then echo "No changes."; return 0; fi
    if compose config -q 2>/dev/null; then break; fi
    compose config -q 2>&1 | sed -n 1,5p >&2 || true      # pipefail: the failing compose call is the point
    read -rp "That file has an error. Edit again? [Y/n] (n puts the old file back) " ans
    if [[ "${ans:-y}" == [nN]* ]]; then cp "$backup" .env; echo "Old .env restored."; return 1; fi
  done
  chmod 600 .env
  read -rp "Apply the changes now? [Y/n] " ans
  if [[ "${ans:-y}" == [nN]* ]]; then echo "Saved. Apply later with: solis-monitor apply"; return 0; fi
  cmd_apply || { read -rp "Put the previous .env back? [y/N] " ans; if [[ "${ans:-n}" == [yY]* ]]; then cp "$backup" .env && cmd_apply; fi; return 1; }
}

# The "Update" button on the dashboard's Settings page cannot run Docker (that container has no access to it).
# It drops a request file in control/; this path unit notices it and runs `update --from-dashboard` here on the host.
cmd_dashboard_updates() {
  local unit_dir="${SOLIS_UNIT_DIR:-/etc/systemd/system}" owner user_line=""
  owner="$(stat -c %U "$SELF")"
  if [[ "$owner" != root ]]; then user_line="User=$owner"; fi
  case "${1:-}" in
    on)
      [[ -n "$(env_value SOLIS_VERSION)" ]] || die "this copy was built from source; the dashboard can only update release installs"
      as_root install -d -o "$owner" -m 755 "$CTL"      # not left to Docker, which would create it as root
      as_root tee "$unit_dir/solis-monitor-dashboard-update.service" >/dev/null <<UNIT
[Unit]
Description=Update Solis Monitor (asked for on the dashboard)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
$user_line
ExecStart=$SELF update --from-dashboard
UNIT
      as_root tee "$unit_dir/solis-monitor-dashboard-update.path" >/dev/null <<UNIT
[Unit]
Description=Watch for update requests from the Solis Monitor dashboard

[Path]
PathChanged=$CTL/update-request
Unit=solis-monitor-dashboard-update.service

[Install]
WantedBy=multi-user.target
UNIT
      printf '{"enabled":true,"version":"%s","updated":"%s"}\n' "$(json_text "$(env_value SOLIS_VERSION)")" "$(now_iso)" | as_root -u "$owner" tee "$CTL/bridge.json" >/dev/null
      as_root systemctl daemon-reload
      as_root systemctl enable --now solis-monitor-dashboard-update.path
      echo "Updating from the dashboard is on: Settings -> System -> Software." ;;
    off)
      as_root systemctl disable --now solis-monitor-dashboard-update.path 2>/dev/null || true
      rm -f "$CTL/bridge.json" "$CTL/update-request"
      echo "Updating from the dashboard is off." ;;
    *) die "usage: solis-monitor dashboard-updates on|off" ;;
  esac
}

cmd_auto_update() {
  case "${1:-}" in
    on)
      # If this folder belongs to a normal user, the nightly job runs as that user, never as root: root would be
      # executing a script that user (or anything running as them) can edit. That user needs Docker access.
      local owner user_line=""
      owner="$(stat -c %U "$SELF")"
      if [[ "$owner" != root ]]; then user_line="User=$owner"; fi
      as_root tee ${SOLIS_UNIT_DIR:-/etc/systemd/system}/solis-monitor-update.service >/dev/null <<UNIT
[Unit]
Description=Update Solis Monitor to the latest release
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
$user_line
ExecStart=$SELF update --auto
UNIT
      as_root tee ${SOLIS_UNIT_DIR:-/etc/systemd/system}/solis-monitor-update.timer >/dev/null <<UNIT
[Unit]
Description=Look for a new Solis Monitor release every night

[Timer]
OnCalendar=*-*-* 04:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
UNIT
      as_root systemctl daemon-reload
      as_root systemctl enable --now solis-monitor-update.timer
      echo "Automatic updates are on: each night the latest tagged release is installed." ;;
    off)
      as_root systemctl disable --now solis-monitor-update.timer 2>/dev/null || true
      echo "Automatic updates are off. Update by hand with: solis-monitor update" ;;
    *) die "usage: solis-monitor auto-update on|off" ;;
  esac
}

case "${1:-}" in
  status) cmd_status ;;
  update) shift; cmd_update "$@" ;;
  auto-update) shift; cmd_auto_update "${1:-}" ;;
  logs) shift; follow=""; if [[ "${1:-}" == -f ]]; then follow=-f; shift; fi; compose logs ${follow:+"$follow"} --tail 100 "$@" ;;
  apply) shift; cmd_apply "${1:-}" ;;
  dashboard-updates) shift; cmd_dashboard_updates "${1:-}" ;;
  edit) cmd_edit ;;
  version) env_value SOLIS_VERSION ;;
  ""|-h|--help|help) sed -n '2,11p' "$SELF" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command '$1' (try: solis-monitor help)" ;;
esac
