#!/usr/bin/env bash
# Manage a Solis Monitor installed by install.sh (it lives in /opt/solis-monitor, with a link at
# /usr/local/bin/solis-monitor). Updates only ever go to tagged releases, never to unreleased code.
#
#   solis-monitor status                 version, containers, latest reading
#   solis-monitor update [--version vX]  install the latest release (or the one named); rolls back on failure
#   solis-monitor auto-update on|off     check for a new release every night (off by default)
#   solis-monitor logs [-f] [service]    recent log lines (poller, web or influxdb); -f keeps following
#   solis-monitor dashboard-updates on|off  let the dashboard's Settings page update and back up this install (off by default for source builds)
#   solis-monitor reset-login            forgot the dashboard password you set? go back to the one in .env
#   solis-monitor secure-tokens          give the dashboard a read-only database token and its own poller secret (installs do this)
#   solis-monitor backup [FILE|DIR]      one .tar.gz with the history, the saved settings and .env
#                                        (default: the folder set on the Settings page, else backups/ here; --from-dashboard: asked
#                                        for on the Settings page, which also keeps only the newest N there; a backup into that
#                                        folder is also copied to Nextcloud/WebDAV when that is set up there, unless --no-copy)
#   solis-monitor restore FILE [--yes]   put a backup back, on this or a fresh install (replaces the history and .env);
#                                        the dashboard's Backup tab can do this too, for the archives in its folder
#   solis-monitor edit                   open .env in your editor, then apply the changes
#   solis-monitor apply [--force]        apply a .env you edited by hand (restarts only what changed)
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
cd "$DIR"
SELF="$DIR/solis-monitor"
# .env is readable by root only (it holds the passwords) and Docker needs root: ask for sudo ourselves.
# Never loops: only a non-root user re-runs itself, once (SOLIS_ELEVATED), and root without a .env just stops.
if [[ ! -r "$DIR/.env" ]]; then
  if [[ $EUID -eq 0 || -n "${SOLIS_ELEVATED:-}" ]]; then
    echo "solis-monitor: cannot read $DIR/.env (is this a Solis Monitor install folder?)" >&2; exit 1
  fi
  command -v sudo >/dev/null || { echo "solis-monitor: needs root (run it as root, or install sudo)" >&2; exit 1; }
  exec sudo env SOLIS_ELEVATED=1 "SOLIS_EDITOR=${VISUAL:-${EDITOR:-}}" "$SELF" "$@"      # sudo drops EDITOR, so pass it along
fi

env_value() { grep -E "^$1=" .env 2>/dev/null | sed -n 1p | cut -d= -f2- | sed 's/[[:space:]]#.*//; s/[[:space:]]*$//' || true; }
set_env() {          # set_env NAME VALUE: replace the NAME= line, or add it
  if grep -qE "^$1=" .env; then sed -i "s|^$1=.*|$1=$2|" .env; else echo "$1=$2" >> .env; fi
}
die() { echo "solis-monitor: $*" >&2; exit 1; }
random_hex() { if command -v openssl >/dev/null; then openssl rand -hex "$1"; else head -c "$1" /dev/urandom | od -An -tx1 | tr -d ' \n'; fi; }
as_root() {         # as_root [-u USER] command...
  local who=()
  if [[ "${1:-}" == -u ]]; then who=(-u "$2"); shift 2; fi
  if [[ $EUID -eq 0 ]]; then
    if ((${#who[@]})); then sudo "${who[@]}" "$@"; else "$@"; fi
  else sudo "${who[@]}" "$@"; fi
}
compose() { docker compose "$@"; }
CTL="$DIR/control"          # shared with the web container: the dashboard's update requests and our progress
ensure_ctl() { [[ -d "$CTL" ]] || mkdir -p "$CTL" 2>/dev/null || true; }
now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }
json_text() { printf '%s' "$1" | tr -d '"\\\n\r' | cut -c1-250; }
REPORT=""; REPORT_DONE=""; REPORT_FROM=""; REPORT_TO=""; REPORT_STARTED=""; REPORT_PERCENT=0
report() {           # report STATE MESSAGE [PERCENT]: progress for the dashboard (only when the dashboard asked for this update)
  [[ -n "$REPORT" ]] || return 0
  local finished=""
  [[ -z "${3:-}" ]] || REPORT_PERCENT="$3"
  [[ "$1" == running ]] || { finished="$(now_iso)"; REPORT_DONE=1; }
  [[ "$1" != ok ]] || REPORT_PERCENT=100
  printf '{"state":"%s","from":"%s","to":"%s","message":"%s","percent":%s,"started":"%s","finished":"%s"}\n' \
    "$1" "$(json_text "$REPORT_FROM")" "$(json_text "$REPORT_TO")" "$(json_text "$2")" "$REPORT_PERCENT" "$REPORT_STARTED" "$finished" \
    > "$CTL/update-status.json.tmp" 2>/dev/null && mv "$CTL/update-status.json.tmp" "$CTL/update-status.json" 2>/dev/null || true
}
finish_report() {    # whatever stopped the update (die, a signal), the dashboard must not wait forever
  [[ -n "$REPORT" && -z "$REPORT_DONE" ]] && report failed "The update stopped before it finished. See: solis-monitor logs" || true
}
refresh_bridge() {   # keep bridge.json (written by `dashboard-updates on`) in step with the installed version
  [[ -f "$CTL/bridge.json" ]] || return 0
  printf '{"enabled":true,"version":"%s","updated":"%s"}\n' "$(json_text "$(env_value SOLIS_VERSION)")" "$(now_iso)" \
    > "$CTL/bridge.json.tmp" 2>/dev/null && mv "$CTL/bridge.json.tmp" "$CTL/bridge.json" 2>/dev/null || true
}

REPO="$(env_value SOLIS_REPO)"
RAW_BASE="${SOLIS_RAW_BASE:-https://raw.githubusercontent.com/${REPO}}"
API_BASE="${SOLIS_API_BASE:-https://api.github.com/repos/${REPO}}"

notify() {           # Telegram notice if the bot is set up in .env
  local token chat site
  token=$(env_value TELEGRAM_BOT_TOKEN); chat=$(env_value TELEGRAM_CHAT_ID); site=$(env_value SITE_NAME)
  [[ -n "$token" && -n "$chat" ]] || return 0
  curl -s -m 15 -o /dev/null "https://api.telegram.org/bot${token}/sendMessage" \
       --data-urlencode "chat_id=${chat}" --data-urlencode "text=${site:+[$site] }$1" || true
}

latest_release() {
  local json
  json=$(curl -fsS -m 20 "$API_BASE/releases/latest") || die "could not look up the latest release on GitHub. If you or other devices on your network asked a lot just now, GitHub's anonymous limit (60 requests an hour per network) may be used up: try again later, or name the version: solis-monitor update --version vX.Y.Z"
  printf '%s' "$json" | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | sed -n 1p
}

cmd_status() {
  echo "Version:   $(env_value SOLIS_VERSION)  (repo $REPO)"
  echo "Dashboard: http://$(hostname -I | awk '{print $1}'):$(env_value WEB_PORT | sed 's/^$/8088/')"
  # An address saved on the dashboard (Settings -> General) wins over INVERTER_HOST in .env.
  local saved env_host
  saved="$(compose exec -T poller cat /data/inverter.json 2>/dev/null | sed -n 's/.*"host": *"\([^"]*\)".*/\1/p' | sed -n 1p || true)"
  env_host="$(env_value INVERTER_HOST || true)"
  if [[ -n "$saved" ]]; then echo "Inverter:  $saved  (saved on the dashboard; .env has ${env_host:-nothing})"
  else echo "Inverter:  ${env_host:-not set yet (enter it on the dashboard: Settings -> General)}"; fi
  if [[ -f "$CTL/bridge.json" ]]; then echo "Dashboard:  can update itself (Settings -> System -> Software)"; else echo "Dashboard:  cannot update itself (solis-monitor dashboard-updates on)"; fi
  if [[ "$(systemctl is-enabled solis-monitor-update.timer 2>/dev/null || true)" == enabled ]]; then
    echo "Updates:   automatic, nightly (solis-monitor auto-update off to stop)"
  else
    echo "Updates:   manual (solis-monitor update)"
  fi
  if [[ -n "$(env_value CONTROL_TOKEN)" && -n "$(env_value INFLUX_READ_TOKEN)" ]]; then
    if read_token_covers_all_buckets "$(env_value INFLUX_READ_TOKEN)"; then
      echo "Tokens:    the dashboard reads the database with a read-only token"
    else
      echo "Tokens:    the dashboard's read-only token predates the 1-minute aggregates; long charts read the raw data until you run: solis-monitor secure-tokens"
    fi
  else
    echo "Tokens:    the dashboard still uses the database admin token (solis-monitor secure-tokens)"
  fi
  poller_health
  local last
  last="$(ls -1t "$(backup_dir)"/solis-monitor-*.tar.gz 2>/dev/null | sed -n 1p || true)"
  if [[ -n "$last" ]]; then echo "Backup:    $(date -r "$last" +%Y-%m-%d\ %H:%M)  $last"; else echo "Backup:    none yet in $(backup_dir) (solis-monitor backup)"; fi
  if [[ -n "$(backup_schedule)" ]]; then echo "           daily at $(backup_schedule)$(scheduler_installed || echo ' (the timer is missing: solis-monitor dashboard-updates on)')"; fi
  if [[ -s "$REMOTE_CONF" ]]; then
    echo "           copied to $(remote_label): $(remote_get URL) $(remote_get FOLDER)$(sed -n 's/.*"last":{"state":"\([a-z]*\)".*"at":"\([^"]*\)".*/  (last: \1, \2)/p' "$CTL/backup-remote.json" 2>/dev/null || true)"
  fi
  compose ps --format 'table {{.Name}}\t{{.Status}}'
  echo "--- poller, last lines ---"
  compose logs --tail 5 poller 2>&1 || true
}

poller_health() {    # one line from the poller's own healthcheck endpoint (liveness, plus whether the inverter answers)
  local h
  h="$(compose exec -T poller python - 2>/dev/null <<'PY' || true
import urllib.request, urllib.error
try:
    print(urllib.request.urlopen("http://127.0.0.1:8780/health", timeout=4).read().decode())
except urllib.error.HTTPError as e:
    print(e.read().decode())
except Exception:
    pass
PY
)"
  case "$h" in
    *'"alive": true'*'"connected": true'*)
      echo "Poller:    reading the inverter (last reading $(printf '%s' "$h" | sed -n 's/.*"last_ok_age_s": *\([0-9.]*\).*/\1/p') s ago)" ;;
    *'"alive": true'*)
      echo "Poller:    running, but no reading from the inverter: $(printf '%s' "$h" | sed -n 's/.*"error": *"\([^"]*\)".*/\1/p; s/.*"error": *null.*/not tried yet/p' | sed -n 1p)" ;;
    *'"alive": false'*)
      echo "Poller:    its poll loop is stuck (solis-monitor logs poller)" ;;
  esac
}

read_token_covers_all_buckets() {   # read_token_covers_all_buckets TOKEN: does the database know it as "read every bucket of the org"?
  local entry
  entry="$(compose exec -T influxdb influx auth list --json 2>/dev/null | tr -d '\n\t' | grep -o "{[^{}]*\"token\": *\"$1\"[^{}]*}" || true)"
  [[ -n "$entry" ]] || return 0                       # cannot tell (the database is down, or the CLI changed): leave it alone
  printf '%s' "$entry" | grep -q '"read:orgs/[0-9a-f]*/buckets"'
}

# Least privilege for the dashboard container: its own secret for the poller's internal API (CONTROL_TOKEN) and a
# read-only InfluxDB token (INFLUX_READ_TOKEN) instead of the database's admin token, which it never needed.
# install.sh runs this once the database is up; an install made before these existed runs it once by hand.
cmd_secure_tokens() {
  local changed="" org token
  if [[ -z "$(env_value CONTROL_TOKEN)" ]]; then
    set_env CONTROL_TOKEN "$(random_hex 32)"; changed=1
    echo "CONTROL_TOKEN: the dashboard and the poller now share their own secret, not the database token."
  fi
  local current; current="$(env_value INFLUX_READ_TOKEN)"
  if [[ -n "$current" ]] && ! read_token_covers_all_buckets "$current"; then
    # made by an earlier version for the one bucket of that time: the 1-minute aggregates (v0.7) need a wider one
    echo "The dashboard's read-only token covers only the raw readings; replacing it with one for every bucket."
    current=""
  fi
  if [[ -z "$current" ]]; then
    org="$(env_value INFLUX_ORG)"
    token="$(compose exec -T influxdb influx auth create --org "$org" --read-buckets --description "Solis Monitor dashboard (read-only)" --json 2>/dev/null | sed -n 's/.*"token": *"\([^"]*\)".*/\1/p' | sed -n 1p || true)"
    [[ -n "$token" ]] || die "the database did not create a read-only token (try: docker compose logs influxdb)"
    set_env INFLUX_READ_TOKEN "$token"; changed=1
    echo "INFLUX_READ_TOKEN: the dashboard now reads the database with a read-only token (every bucket, read only)."
  fi
  if [[ -z "$changed" ]]; then echo "Already done: the dashboard has its own tokens."; return 0; fi
  chmod 600 .env
  compose up -d poller web
  echo "Applied."
}

# One archive with everything that makes this site: the database (influx backup, taken online), the files saved from
# the dashboard (logger address, battery capacity, events in progress; tariff versions, a changed password), .env and
# the compose file. Keep it somewhere else than this machine: a dead SD card is the reason to have it.
# Where the archives go: a folder set on the dashboard's Backup tab (kept by us in control/backup-config.json, after the
# checks below), else backups/ here. The dashboard lists the folder from the index we write after each backup, because
# the web container only sees backups/ here.
backup_dir() { local d; d="$(sed -n 's/.*"dir":"\([^"]*\)".*/\1/p' "$CTL/backup-config.json" 2>/dev/null | sed -n 1p || true)"; printf '%s' "${d:-$DIR/backups}"; }
backup_keep() { local k; k="$(sed -n 's/.*"keep":\([0-9]*\).*/\1/p' "$CTL/backup-config.json" 2>/dev/null | sed -n 1p || true)"; printf '%s' "${k:-${SOLIS_BACKUP_KEEP:-5}}"; }
backup_schedule() { sed -n 's/.*"schedule":"\([0-9][0-9]:[0-9][0-9]\)".*/\1/p' "$CTL/backup-config.json" 2>/dev/null | sed -n 1p || true; }
# The timer that makes the daily backups (installed by dashboard-updates on); the page offers a time only when it is there.
scheduler_installed() { [[ -f "${SOLIS_UNIT_DIR:-/etc/systemd/system}/solis-monitor-backup.timer" ]]; }
write_backup_config() {   # write_backup_config DIR KEEP [SCHEDULE]: the schedule stays as it was unless given ("" = off)
  local schedule scheduler=false
  if (($# >= 3)); then schedule="$3"; else schedule="$(backup_schedule)"; fi
  scheduler_installed && scheduler=true
  ensure_ctl
  printf '{"dir":"%s","default_dir":"%s","keep":%s,"schedule":"%s","scheduler":%s}\n' "$(json_text "$1")" "$(json_text "$DIR/backups")" "$2" \
    "$(json_text "$schedule")" "$scheduler" > "$CTL/backup-config.json.tmp" 2>/dev/null \
    && mv "$CTL/backup-config.json.tmp" "$CTL/backup-config.json" 2>/dev/null || true
}
write_backup_index() {    # write_backup_index DIR: what is in the backup folder, for the dashboard's list
  local d="$1" f sep=""
  ensure_ctl
  { printf '{"dir":"%s","files":[' "$(json_text "$d")"
    ls -1t "$d"/solis-monitor-*.tar.gz 2>/dev/null | while read -r f; do
      printf '%s{"name":"%s","size":%s,"created":"%s"}' "$sep" "$(json_text "$(basename "$f")")" "$(stat -c %s "$f")" "$(date -u -r "$f" +%Y-%m-%dT%H:%M:%SZ)"
      sep=","
    done
    printf ']}\n'; } > "$CTL/backups.json.tmp" 2>/dev/null && mv "$CTL/backups.json.tmp" "$CTL/backups.json" 2>/dev/null || true
}
# A folder the dashboard asks for is only accepted when it looks like a place for backups (a mount, a home, /opt ...),
# exists and is writable: the request comes from a browser, and this runs with the install folder's rights.
valid_backup_dir() {      # valid_backup_dir PATH: prints why not, and fails, when it is not acceptable
  local root ok="" extra
  extra="$(env_value SOLIS_BACKUP_ROOTS)"                  # more allowed roots, colon-separated, for other mount points
  for root in ${extra//:/ }; do [[ "$1" == "$root" || "$1" == "$root/"* ]] && ok=1; done
  case "$1" in
    *..*|*" "*) echo "That folder name is not allowed."; return 1 ;;
    "$DIR/backups"|"$DIR/backups/"*|/mnt/?*|/media/?*|/srv/?*|/home/?*|/opt/?*|/var/backups|/var/backups/?*|/backup|/backup/?*|/backups|/backups/?*|/data|/data/?*) ;;
    *) [[ -n "$ok" ]] || { echo "That folder is not allowed. Use one under /mnt, /media, /srv, /home, /opt, /var/backups, /backup, /backups or /data (or add its root to SOLIS_BACKUP_ROOTS in .env)."; return 1; } ;;
  esac
  [[ -d "$1" ]] || { echo "That folder does not exist on the server. Create it, or mount the drive, first."; return 1; }
  local probe="$1/.solis-monitor-write-test.$$"
  if ! { : > "$probe"; } 2>/dev/null; then echo "That folder is not writable for the backup helper."; return 1; fi
  rm -f "$probe"
}

# One field of a request from the dashboard: a string, number or true/false. The web app writes it with Python's json
# (a space after each colon), a hand-made one may have none: both must read the same, or the action is missed and the
# request falls back to making a backup.
req_value() {      # req_value KEY JSON
  printf '%s' "$2" | sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\{0,1\}\([^\", }]*\).*/\1/p" | sed -n 1p
}

BREPORT=""; BREPORT_DONE=""; BREPORT_STARTED=""; SCHEDULED=""; COPY_STATE=""; COPY_MESSAGE=""
breport() {          # breport STATE MESSAGE [FILE]: progress for the dashboard's Backup tab (when it asked, or for a scheduled one)
  [[ -n "$BREPORT" ]] || return 0
  local finished=""
  [[ "$1" == running ]] || { finished="$(now_iso)"; BREPORT_DONE=1; }
  printf '{"state":"%s","message":"%s","file":"%s","started":"%s","finished":"%s","scheduled":%s,"copy":"%s","copy_message":"%s"}\n' \
    "$1" "$(json_text "$2")" "$(json_text "${3:-}")" "$BREPORT_STARTED" "$finished" "$([[ -n "$SCHEDULED" ]] && echo true || echo false)" \
    "$COPY_STATE" "$(json_text "$COPY_MESSAGE")" \
    > "$CTL/backup-status.json.tmp" 2>/dev/null && mv "$CTL/backup-status.json.tmp" "$CTL/backup-status.json" 2>/dev/null || true
}
finish_breport() {
  [[ -n "$BREPORT" && -z "$BREPORT_DONE" ]] || return 0
  breport failed "The backup stopped before it finished. See: solis-monitor logs"
  [[ -z "$SCHEDULED" ]] || notify "⚠️ The daily backup failed. See: solis-monitor logs"
}

cmd_backup() {
  local target="" site stamp file tmp copy=1
  while (($#)); do
    case "$1" in
      --from-dashboard) BREPORT=1; shift ;;   # started by the dashboard's request file; report progress back
      --scheduled) SCHEDULED=1; shift ;;      # from solis-monitor-backup.timer, every 15 minutes: backs up only when due
      --no-copy) copy=""; shift ;;
      -*) die "unknown option $1" ;;
      *) target="$1"; shift ;;
    esac
  done
  tmp=""; trap 'rm -rf "${tmp:-}"; finish_breport' EXIT
  if [[ -n "$BREPORT" ]]; then
    [[ -e "$CTL/backup-request" ]] || { BREPORT=""; return 0; }          # the path unit also fires when the request is removed
    local request action
    request="$(head -c 2000 "$CTL/backup-request" 2>/dev/null || true)"
    rm -f "$CTL/backup-request" || die "cannot remove $CTL/backup-request (is the folder owned by the user running this?)"
    BREPORT_STARTED="$(now_iso)"
    exec 8>"$DIR/.backup.lock"          # here, not in /tmp: a lock left there by root would block a run as the folder owner
    flock -n 8 || { echo "another backup is running"; BREPORT=""; exit 0; }
    action="$(req_value action "$request")"
    case "$action" in
      "") ;;                                                             # no action: make a backup
      set-folder) set_backup_folder "$request"; return $? ;;
      remove) remove_backup "$request"; return $? ;;
      restore) restore_from_dashboard "$request"; return $? ;;
      set-remote) set_remote "$request"; return $? ;;
      remove-remote) remove_remote; return $? ;;
      set-schedule) set_schedule "$request"; return $? ;;
      *) breport failed "The server does not know that request."; echo "solis-monitor: unknown request '$action'" >&2; return 1 ;;
    esac
  elif [[ -n "$SCHEDULED" ]]; then
    scheduled_due || return 0                                            # most runs of the timer: not yet, or done today
    exec 8>"$DIR/.backup.lock"
    flock -n 8 || { echo "another backup is running; trying again in 15 minutes"; return 0; }
    ensure_ctl; date +%s > "$CTL/backup-last-scheduled"                 # one try a day: a failure is reported, not repeated
    BREPORT=1; BREPORT_STARTED="$(now_iso)"
  fi
  target="${target:-$(backup_dir)}"
  site="$(env_value SITE_NAME | tr -cs 'A-Za-z0-9' '-' | sed 's/^-//; s/-$//')"
  stamp="$(date +%Y%m%d-%H%M%S)"
  if [[ "$target" == *.tar.gz ]]; then file="$target"; else file="$target/solis-monitor${site:+-$site}-$stamp.tar.gz"; fi
  make_archive "$file"
  if [[ "$(dirname "$file")" == "$(backup_dir)" ]]; then
    if [[ -n "$BREPORT" ]]; then
      # Asked for from the dashboard (or scheduled): keep only the newest N in the backup folder, so it cannot fill the disk.
      # Archives made by hand elsewhere, and the ones you downloaded, are not touched.
      local keep old; keep="$(backup_keep)"
      ls -1t "$(backup_dir)"/solis-monitor-*.tar.gz 2>/dev/null | tail -n +"$((keep + 1))" | while read -r old; do rm -f "$old"; done
    fi
    write_backup_index "$(backup_dir)"
    [[ -z "$copy" ]] || remote_copy "$file" || true                     # a failed copy is reported; the archive stays here
  fi
  [[ -z "$BREPORT" ]] || breport ok "Backup written" "$(basename "$file")"
}

make_archive() {          # make_archive FILE: the database (online), the saved files, .env and the compose file, as one .tar.gz
  local file="$1" tmp
  mkdir -p "$(dirname "$file")" || die "cannot create $(dirname "$file")"
  tmp="$(mktemp -d)"
  echo "Backing up the database ..."
  breport running "Backing up the database"
  # influx backup writes a folder inside the container; it is streamed out as a tar so nothing is left behind there.
  compose exec -T influxdb sh -c 'rm -rf /tmp/solis-backup && influx backup /tmp/solis-backup >&2 && tar -C /tmp/solis-backup -c . && rm -rf /tmp/solis-backup' \
    > "$tmp/influxdb.tar" || die "the database backup failed (is the stack running? solis-monitor status)"
  [[ -s "$tmp/influxdb.tar" ]] || die "the database backup is empty"
  compose exec -T poller tar -C /data -c . > "$tmp/poller-data.tar" 2>/dev/null || : > "$tmp/poller-data.tar"
  compose exec -T web tar -C /data -c . > "$tmp/web-data.tar" 2>/dev/null || : > "$tmp/web-data.tar"
  cp .env "$tmp/env"; cp docker-compose.yml "$tmp/docker-compose.yml"
  printf '{"format":1,"created":"%s","version":"%s","site":"%s"}\n' "$(now_iso)" "$(json_text "$(env_value SOLIS_VERSION)")" "$(json_text "$(env_value SITE_NAME)")" > "$tmp/manifest.json"
  breport running "Packing the archive"
  tar -czf "$file" -C "$tmp" manifest.json env docker-compose.yml influxdb.tar poller-data.tar web-data.tar
  chmod 600 "$file"                      # it holds .env, with every password and token
  rm -rf "$tmp"
  echo "Backup written: $file ($(du -h "$file" | cut -f1))"
  echo "It contains your passwords and tokens: keep it private, and copy it off this machine."
}

# The dashboard asked to restore one of the archives in the backup folder. First a backup of the current state (unless
# told not to), so a wrong click is itself recoverable; then the same restore as `solis-monitor restore FILE --yes`.
restore_from_dashboard() {
  local name first
  name="$(req_value name "$1")"
  first="$(req_value backup_first "$1")"
  if [[ ! "$name" =~ ^solis-monitor(-[A-Za-z0-9][A-Za-z0-9-]{0,60})?-[0-9]{8}-[0-9]{6}\.tar\.gz$ ]]; then
    breport failed "That is not the name of a backup."; echo "solis-monitor: refused to restore '$name'" >&2; return 1
  fi
  local file; file="$(backup_dir)/$name"
  if [[ ! -f "$file" ]]; then breport failed "No such backup."; return 1; fi
  if [[ "$first" != false ]]; then
    local site stamp
    site="$(env_value SITE_NAME | tr -cs 'A-Za-z0-9' '-' | sed 's/^-//; s/-$//')"
    stamp="$(date +%Y%m%d-%H%M%S)"
    breport running "Backing up the current state first"
    make_archive "$(backup_dir)/solis-monitor${site:+-$site}-$stamp.tar.gz"
    write_backup_index "$(backup_dir)"
  fi
  cmd_restore "$file" --yes
  write_backup_index "$(backup_dir)"
  breport ok "Restored from $name"
}

remove_backup() {         # the dashboard asked to delete one archive from the backup folder
  local name
  name="$(req_value name "$1")"
  if [[ ! "$name" =~ ^solis-monitor(-[A-Za-z0-9][A-Za-z0-9-]{0,60})?-[0-9]{8}-[0-9]{6}\.tar\.gz$ ]]; then
    breport failed "That is not the name of a backup."; echo "solis-monitor: refused to remove '$name'" >&2; return 1
  fi
  if [[ ! -f "$(backup_dir)/$name" ]]; then breport failed "No such backup."; return 1; fi
  rm -f "$(backup_dir)/$name"
  write_backup_index "$(backup_dir)"
  echo "Removed $(backup_dir)/$name"
  breport ok "Removed $name"
}

set_backup_folder() {     # the dashboard asked for another folder (and how many archives to keep there)
  local d keep reason
  d="$(req_value dir "$1")"
  keep="$(req_value keep "$1")"
  [[ "$keep" =~ ^[0-9]+$ && "$keep" -ge 1 && "$keep" -le 50 ]] || keep=5
  if ! reason="$(valid_backup_dir "$d")"; then breport failed "$reason"; echo "solis-monitor: $reason" >&2; return 1; fi
  write_backup_config "$d" "$keep"
  write_backup_index "$d"
  echo "Backups go to $d (keeping the newest $keep made from the dashboard)."
  breport ok "Folder set to $d"
}

# --- Daily backups: solis-monitor-backup.timer runs `backup --scheduled` every 15 minutes; it backs up once a day, at
# the first run after the time set on the Backup tab (so a machine that was off at that time catches up when it starts).
scheduled_due() {
  local at slot last now
  at="$(backup_schedule)"; [[ -n "$at" ]] || return 1
  now="$(date +%s)"; slot="$(date -d "today $at" +%s 2>/dev/null)" || return 1
  last="$(cat "$CTL/backup-last-scheduled" 2>/dev/null || true)"; [[ "$last" =~ ^[0-9]+$ ]] || last=0
  ((now >= slot && last < slot))
}

set_schedule() {          # the dashboard asked for a daily backup at HH:MM, or none
  local at
  at="$(req_value time "$1")"
  [[ "$at" == off ]] && at=""
  if [[ -n "$at" && ! "$at" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; then breport failed "That is not a time of day."; return 1; fi
  if [[ -n "$at" ]] && ! scheduler_installed; then
    breport failed "Daily backups need the timer on the server. On the server run: solis-monitor dashboard-updates on"; return 1
  fi
  write_backup_config "$(backup_dir)" "$(backup_keep)" "$at"
  if [[ -n "$at" ]]; then echo "A backup is made every day at $at."; breport ok "Daily backups are on."
  else echo "Daily backups are off."; breport ok "Daily backups are off."; fi
}

# --- A copy in Nextcloud or on another WebDAV server, set on the Backup tab. The password is kept here, in a file only
# this install's owner can read, and never in control/ (the web container reads that): the page only learns that one is
# set. Every value is stored base64-encoded, so nothing in it (quotes, spaces, $) is ever parsed by the shell, and it
# reaches curl only through a config on a pipe (never the command line, which ps would show).
REMOTE_CONF="$DIR/backup-remote.conf"
remote_get() {            # remote_get KEY [FILE]
  local v; v="$(sed -n "s/^$1=//p" "${2:-$REMOTE_CONF}" 2>/dev/null | sed -n 1p || true)"
  [[ -z "$v" ]] || printf '%s' "$v" | base64 -d 2>/dev/null || true
}
b64() { printf '%s' "$1" | base64 -w0; }
urlenc() {                # one path segment, percent-encoded byte by byte
  local LC_ALL=C s="$1" out="" c i
  for ((i = 0; i < ${#s}; i++)); do
    c="${s:i:1}"
    case "$c" in [A-Za-z0-9._~-]) out+="$c" ;; *) printf -v c '%%%02X' "'$c"; out+="$c" ;; esac
  done
  printf '%s' "$out"
}
curl_quoted() { local v="${1//\\/\\\\}"; printf '"%s"' "${v//\"/\\\"}"; }
RCONF=""                  # the settings dav() uses: the saved ones, or new ones while they are tested
dav() {                   # dav METHOD URL [curl args...]: prints the HTTP status; 000 not reached, cut, timeout
  local method="$1" url="$2" conf="${RCONF:-$REMOTE_CONF}" code rc=0; shift 2
  code="$(curl -sS -m "${SOLIS_DAV_TIMEOUT:-600}" -o "${DAV_OUT:-/dev/null}" -w '%{http_code}' -X "$method" \
    -K <(printf 'user = %s\n' "$(curl_quoted "$(remote_get USER "$conf"):$(remote_get PASS "$conf")")") "$@" "$url" 2>/dev/null)" || rc=$?
  case "$rc" in 52|55|56) code="cut" ;; 28) code="timeout" ;; esac
  printf '%s' "${code:-000}"
}
dav_reason() {            # a sentence for the page from an HTTP status
  case "$1" in
    000) echo "The server could not be reached." ;;
    cut) echo "The server broke the connection off. It may limit how much one request can send." ;;
    timeout) echo "The server did not answer in time." ;;
    401) echo "The server refused the user name or password." ;;
    403) echo "The server does not let this user write there." ;;
    404|409) echo "That address or folder was not found on the server." ;;
    413) echo "The server refused a file this large." ;;
    507) echo "The server has no room left." ;;
    *) echo "The server answered with an error (HTTP $1)." ;;
  esac
}
remote_label() { if [[ "$(remote_get KIND "${RCONF:-$REMOTE_CONF}")" == nextcloud ]]; then echo Nextcloud; else echo "the WebDAV server"; fi; }
remote_urls() {           # sets R_DIR (our folder), R_DIRS (each level of it, to create), R_UP (Nextcloud's upload area)
  local conf="${RCONF:-$REMOTE_CONF}" url user seg path="" root parts
  url="$(remote_get URL "$conf")"; url="${url%/}"; user="$(remote_get USER "$conf")"
  if [[ "$(remote_get KIND "$conf")" == nextcloud ]]; then
    root="$url/remote.php/dav/files/$(urlenc "$user")"; R_UP="$url/remote.php/dav/uploads/$(urlenc "$user")"
  else root="$url"; R_UP=""; fi
  R_DIRS=()
  IFS=/ read -ra parts <<< "$(remote_get FOLDER "$conf")"
  for seg in "${parts[@]}"; do [[ -n "$seg" ]] || continue; path+="/$(urlenc "$seg")"; R_DIRS+=("$root$path"); done
  R_DIR="$root$path"
}
remote_mkdirs() {         # create the folder one level at a time (201 made, 405 already there); prints a failing status
  local d code
  for d in "${R_DIRS[@]}"; do
    code="$(dav MKCOL "$d/")"
    [[ "$code" == 201 || "$code" == 405 ]] || { echo "$code"; return 1; }
  done
  [[ ${#R_DIRS[@]} -gt 0 ]] || { code="$(dav PROPFIND "$R_DIR/" -H 'Depth: 0')"; [[ "$code" == 207 ]] || { echo "$code"; return 1; }; }
}
remote_size() {           # remote_size URL: the size the server has for a file
  local out; out="$(mktemp)"
  DAV_OUT="$out" dav PROPFIND "$1" -H 'Depth: 0' >/dev/null
  grep -oiE 'getcontentlength[^>]*>[0-9]+' "$out" | grep -oE '[0-9]+$' | sed -n 1p || true
  rm -f "$out"
}
# One file up. Nextcloud: its chunked upload (5 MB pieces, each retried, joined by Nextcloud only once all are there),
# because some servers cut one large request off. Other servers: one PUT under a .part name, renamed when complete.
# Either way a broken upload never shows up as a backup there. Prints a failing status.
remote_put() {            # remote_put FILE NAME
  local file="$1" dest size code up n try ok chunk work
  dest="$R_DIR/$(urlenc "$2")"; size="$(stat -c %s "$file")"
  if [[ -n "$R_UP" ]]; then
    up="$R_UP/solis-monitor-$(date +%s)-$$"
    code="$(dav MKCOL "$up" -H "Destination: $dest")"
    [[ "$code" == 201 ]] || { echo "$code"; return 1; }
    work="$(mktemp -d)"
    split -b "${SOLIS_DAV_CHUNK_MB:-5}M" -d -a 5 "$file" "$work/c"
    n=0
    for chunk in "$work"/c*; do
      n=$((n + 1)); ok=""
      for try in 1 2 3; do
        code="$(dav PUT "$up/$(printf '%05d' "$n")" -T "$chunk" -H "Destination: $dest" -H "OC-Total-Length: $size")"
        if [[ "$code" == 201 || "$code" == 204 ]]; then ok=1; break; fi
        sleep "$((try * ${SOLIS_DAV_RETRY_S:-10}))"
      done
      [[ -n "$ok" ]] || { rm -rf "$work"; dav DELETE "$up" >/dev/null; echo "$code"; return 1; }
    done
    rm -rf "$work"
    code="$(dav MOVE "$up/.file" -H "Destination: $dest" -H "OC-Total-Length: $size" -H 'Overwrite: T')"
    [[ "$code" == 201 || "$code" == 204 ]] || { dav DELETE "$up" >/dev/null; echo "$code"; return 1; }
  else
    code="$(dav PUT "$dest.part" -T "$file")"
    [[ "$code" == 201 || "$code" == 204 ]] || { dav DELETE "$dest.part" >/dev/null; echo "$code"; return 1; }
    code="$(dav MOVE "$dest.part" -H "Destination: $dest" -H 'Overwrite: T')"
    [[ "$code" == 201 || "$code" == 204 ]] || { dav DELETE "$dest.part" >/dev/null; echo "$code"; return 1; }
  fi
  if [[ "$(remote_size "$dest")" != "$size" ]]; then dav DELETE "$dest" >/dev/null; echo size; return 1; fi
}
remote_prune() {          # keep the newest KEEP of this site's archives there; others' files (and other sites') are left alone
  local keep site out names n=0 f
  keep="$(remote_get KEEP)"; [[ "$keep" =~ ^[0-9]+$ && "$keep" -ge 1 ]] || keep=14
  site="$(env_value SITE_NAME | tr -cs 'A-Za-z0-9' '-' | sed 's/^-//; s/-$//')"
  out="$(mktemp)"
  [[ "$(DAV_OUT="$out" dav PROPFIND "$R_DIR/" -H 'Depth: 1')" == 207 ]] || { rm -f "$out"; return 0; }
  names="$(grep -oiE '<([a-z0-9]+:)?href>[^<]*</([a-z0-9]+:)?href>' "$out" | sed -E 's#<[^>]*>##g; s#.*/##' \
    | grep -E "^solis-monitor${site:+-$site}-[0-9]{8}-[0-9]{6}\.tar\.gz(\.part)?$" | sort -r || true)"
  rm -f "$out"
  while read -r f; do
    [[ -n "$f" ]] || continue
    if [[ "$f" == *.part ]]; then dav DELETE "$R_DIR/$f" >/dev/null; continue; fi     # left by an upload that broke off
    n=$((n + 1)); ((n <= keep)) || dav DELETE "$R_DIR/$f" >/dev/null
  done <<< "$names"
}
write_remote_info() {     # write_remote_info [STATE MESSAGE FILE]: what the page shows (never the password)
  ensure_ctl
  [[ -s "$REMOTE_CONF" ]] || { rm -f "$CTL/backup-remote.json"; return 0; }
  local last=""
  [[ -z "${1:-}" ]] || last="$(printf ',"last":{"state":"%s","message":"%s","file":"%s","at":"%s"}' "$1" "$(json_text "$2")" "$(json_text "$3")" "$(now_iso)")"
  printf '{"kind":"%s","url":"%s","user":"%s","folder":"%s","keep":%s%s}\n' "$(json_text "$(remote_get KIND)")" "$(json_text "$(remote_get URL)")" \
    "$(json_text "$(remote_get USER)")" "$(json_text "$(remote_get FOLDER)")" "$(remote_get KEEP)" "$last" \
    > "$CTL/backup-remote.json.tmp" 2>/dev/null && mv "$CTL/backup-remote.json.tmp" "$CTL/backup-remote.json" 2>/dev/null || true
}
remote_copy() {           # remote_copy FILE: after a backup into the backup folder, when a server is set on the Backup tab
  [[ -s "$REMOTE_CONF" ]] || return 0
  local file="$1" name label code
  name="$(basename "$file")"; label="$(remote_label)"
  echo "Copying to $label ..."
  breport running "Copying to $label"
  remote_urls
  if ! code="$(remote_mkdirs)" || ! code="$(remote_put "$file" "$name")"; then
    if [[ "$code" == size ]]; then COPY_MESSAGE="The copy on the server is incomplete."; else COPY_MESSAGE="$(dav_reason "$code")"; fi
    COPY_STATE=failed
    echo "solis-monitor: the copy to $label failed: $COPY_MESSAGE The backup is still here: $file" >&2
    write_remote_info failed "$COPY_MESSAGE" "$name"
    notify "⚠️ The backup could not be copied to $label: $COPY_MESSAGE"
    return 1
  fi
  remote_prune
  COPY_STATE=ok; COPY_MESSAGE="Copied to $label."
  write_remote_info ok "$COPY_MESSAGE" "$name"
  echo "Copied to $label: $R_DIR/$name"
}

# The dashboard asked to copy the backups to a server. The values come base64-encoded (any character is allowed in a
# password) and are checked here again; then the connection is tried (the folder created, a small file written and
# removed) and only settings that work are kept. An empty password keeps the saved one.
req_b64() { req_value "$1_b64" "$2" | base64 -d 2>/dev/null || true; }
set_remote() {
  local kind url user pass folder keep code new
  kind="$(req_value kind "$1")"; keep="$(req_value keep "$1")"
  url="$(req_b64 url "$1")"; user="$(req_b64 user "$1")"; pass="$(req_b64 password "$1")"; folder="$(req_b64 folder "$1")"
  url="${url%/}"
  [[ "$kind" == nextcloud || "$kind" == webdav ]] || { breport failed "The server does not know that request."; return 1; }
  if [[ ${#url} -gt 300 || ! "$url" =~ ^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~%/+-]*)?$ ]]; then
    breport failed "The address must start with http:// or https://."; return 1
  fi
  if [[ -z "$user" || ${#user} -gt 200 || "$user" == *:* || "$user" =~ [[:cntrl:]] ]]; then breport failed "Enter the user name."; return 1; fi
  [[ -n "$pass" ]] || pass="$(remote_get PASS)"
  if [[ -z "$pass" || ${#pass} -gt 500 || "$pass" =~ [[:cntrl:]] ]]; then breport failed "Enter the password."; return 1; fi
  if [[ ${#folder} -gt 200 || "$folder" =~ (^|/)\.\.?(/|$) || "$folder" =~ [[:cntrl:]] || "$folder" == *[\"\\]* ]]; then
    breport failed "That folder name is not allowed."; return 1
  fi
  [[ "$keep" =~ ^[0-9]+$ && "$keep" -ge 1 && "$keep" -le 100 ]] || keep=14
  new="$REMOTE_CONF.new"
  (umask 077; printf 'KIND=%s\nURL=%s\nUSER=%s\nPASS=%s\nFOLDER=%s\nKEEP=%s\n' "$(b64 "$kind")" "$(b64 "$url")" "$(b64 "$user")" \
    "$(b64 "$pass")" "$(b64 "${folder#/}")" "$(b64 "$keep")" > "$new")
  RCONF="$new"
  breport running "Trying the connection"
  remote_urls
  local probe; probe="$(mktemp)"; echo "Solis Monitor checks that it can write here; this file is removed at once." > "$probe"
  if ! code="$(remote_mkdirs)" || ! code="$(dav PUT "$R_DIR/.solis-monitor-test" -T "$probe")" || [[ "$code" != 201 && "$code" != 204 ]]; then
    rm -f "$probe" "$new"; RCONF=""
    breport failed "$(dav_reason "$code")"; echo "solis-monitor: $(dav_reason "$code")" >&2; return 1
  fi
  dav DELETE "$R_DIR/.solis-monitor-test" >/dev/null
  rm -f "$probe"; RCONF=""
  mv "$new" "$REMOTE_CONF"
  write_remote_info
  echo "Backups are copied to $(remote_label) from now on (keeping the newest $keep there)."
  breport ok "Connected. Backups are copied there from now on."
}
remove_remote() {
  rm -f "$REMOTE_CONF" "$REMOTE_CONF.new"
  write_remote_info
  echo "Backups are no longer copied to a server (the copies already there stay)."
  breport ok "Backups are no longer copied to a server."
}

# The opposite: the database is replaced in full (influx restore --full, so the tokens in the restored .env match it),
# the saved files are put back, and .env is taken from the backup except for the installer's own lines (which release
# is installed, from where). Works on the install the backup was made on and on a fresh one. Nothing is kept from before.
cmd_restore() {
  local file="" yes="" tmp ans manifest created version site key
  while (($#)); do
    case "$1" in
      --yes) yes=1; shift ;;
      -*) die "unknown option $1" ;;
      *) file="$1"; shift ;;
    esac
  done
  [[ -n "$file" ]] || die "usage: solis-monitor restore FILE [--yes]"
  [[ -r "$file" ]] || die "cannot read $file"
  tmp="$(mktemp -d)"; trap 'rm -rf "${tmp:-}"; finish_breport' EXIT      # finish_breport: a no-op unless the dashboard asked
  tar -xzf "$file" -C "$tmp" || die "$file is not a backup made by solis-monitor backup"
  for key in manifest.json env influxdb.tar; do [[ -s "$tmp/$key" ]] || die "$file is missing $key: not a backup made by solis-monitor backup"; done
  manifest="$(cat "$tmp/manifest.json")"
  created="$(printf '%s' "$manifest" | sed -n 's/.*"created":"\([^"]*\)".*/\1/p')"
  version="$(printf '%s' "$manifest" | sed -n 's/.*"version":"\([^"]*\)".*/\1/p')"
  site="$(printf '%s' "$manifest" | sed -n 's/.*"site":"\([^"]*\)".*/\1/p')"
  echo "Backup from ${created:-?}${site:+ of \"$site\"}, made on version ${version:-?}."
  echo "Restoring REPLACES this install's history, the settings saved on the dashboard and .env (the installed version is kept)."
  if [[ -z "$yes" ]]; then
    read -rp "Continue? [y/N] " ans || true           # no terminal (EOF) counts as no
    [[ "${ans:-n}" == [yY]* ]] || { echo "Nothing changed."; return 1; }
  fi
  echo "Stopping the poller and the dashboard ..."
  breport running "Stopping the poller and the dashboard"
  compose stop poller web
  compose up -d influxdb
  echo "Restoring the database ..."
  breport running "Restoring the database"
  compose exec -T influxdb sh -c 'rm -rf /tmp/solis-restore && mkdir /tmp/solis-restore && tar -C /tmp/solis-restore -x && influx restore --full /tmp/solis-restore >&2 && rm -rf /tmp/solis-restore' \
    < "$tmp/influxdb.tar" || die "the database restore failed; the poller and the dashboard are stopped (solis-monitor apply starts them again)"
  # .env from the backup; the installer's lines (which release, from where) stay those of this install
  local keep=() name
  for name in SOLIS_IMAGE_PREFIX SOLIS_VERSION SOLIS_REPO; do keep+=("$name=$(env_value "$name")"); done
  install -m 600 "$tmp/env" .env
  for name in "${keep[@]}"; do set_env "${name%%=*}" "${name#*=}"; done
  # the database's CLI (used by secure-tokens and the docs) must use the restored admin token from now on
  compose exec -T influxdb influx config set --config-name default --token "$(env_value INFLUX_TOKEN)" >/dev/null 2>&1 || true
  echo "Starting with the restored settings ..."
  breport running "Starting with the restored settings"
  ensure_ctl
  compose up -d --force-recreate --remove-orphans          # every container gets the restored .env
  if [[ -s "$tmp/poller-data.tar" ]]; then compose exec -T poller tar -C /data -x < "$tmp/poller-data.tar" || echo "could not restore the poller's saved files" >&2; fi
  if [[ -s "$tmp/web-data.tar" ]]; then compose exec -T web tar -C /data -x < "$tmp/web-data.tar" || echo "could not restore the dashboard's saved files" >&2; fi
  compose restart poller web                                # they read those files when they start
  if wait_healthy; then echo "Restored. The dashboard is up with the history and settings from the backup."
  else echo "Restored, but the dashboard or the poller is not healthy yet. Look at: solis-monitor logs poller" >&2; return 1; fi
}

cmd_update() {
  local target=""
  while (($#)); do
    case "$1" in
      --version) target="${2:?--version needs a tag, e.g. v1.2.0}"; shift 2 ;;
      --auto) shift ;;                       # from the nightly timer; same as by hand
      --from-dashboard) REPORT=1; shift ;;   # started by the dashboard's request file; report progress back
      *) die "unknown option $1" ;;
    esac
  done
  [[ -n "$REPO" ]] || die "SOLIS_REPO is missing from .env"
  tmp=""; trap 'rm -rf "${tmp:-}"; finish_report' EXIT
  if [[ -n "$REPORT" ]]; then
    # The path unit also fires when we delete the request below: with no request there is nothing to do.
    [[ -e "$CTL/update-request" ]] || { REPORT=""; return 0; }
    rm -f "$CTL/update-request" || die "cannot remove $CTL/update-request (is the folder owned by the user running this?)"
    REPORT_STARTED="$(now_iso)"
  fi
  exec 9>"$DIR/.update.lock"           # not in /tmp: with fs.protected_regular=2 root cannot open a lock another user left there
  flock -n 9 || { echo "another update is running"; REPORT=""; exit 0; }

  local current explicit="$target"
  current="$(env_value SOLIS_VERSION)"; REPORT_FROM="$current"
  report running "Looking for the newest release" 5
  [[ -n "$target" ]] || target="$(latest_release)"
  [[ -n "$target" ]] || die "no release found"
  REPORT_TO="$target"
  if [[ "$target" == "$current" ]]; then echo "Already on $current."; report ok "Already on $current"; return 0; fi
  # sort -V puts v1.2.0 before v1.2.0-rc.1, but a test release comes before its final version.
  if [[ -z "$explicit" && "$target" != "${current%%-*}" && "$(printf '%s\n%s\n' "$current" "$target" | sort -V | sed -n 2p)" == "$current" ]]; then
    echo "Latest release $target is not newer than $current."; report ok "Already on the newest release ($current)"; return 0      # never downgrade by itself
  fi

  echo "Updating $current -> $target"
  report running "Downloading the files of $target" 15
  tmp="$(mktemp -d)"
  curl -fsS -m 60 -o "$tmp/docker-compose.yml" "$RAW_BASE/$target/docker-compose.yml" || die "could not download $target"
  curl -fsS -m 60 -o "$tmp/solis-monitor" "$RAW_BASE/$target/deploy/solis-monitor" || die "could not download $target"

  cp docker-compose.yml docker-compose.yml.prev
  install -m 644 "$tmp/docker-compose.yml" docker-compose.yml
  set_env SOLIS_VERSION "$target"

  # Only our own images: the database image is not refreshed behind your back (that restart took ~2 minutes on a Pi).
  # A release that names another database version still gets it, because `up` pulls what is missing.
  # One image at a time, so the dashboard's progress bar has something real to show on a slow link.
  local image pct=20
  for image in poller web; do
    report running "Downloading the $image image" "$pct"
    if ! compose pull --quiet "$image"; then
      echo "Could not download the images for $target; staying on $current." >&2
      restore "$current"; report failed "Could not download the images for $target. Still on $current."; return 1
    fi
    pct=$((pct + 25))
  done
  report running "Restarting with $target" 72
  ensure_ctl
  compose up -d --remove-orphans
  if wait_healthy; then
    install -m 755 "$tmp/solis-monitor" "$SELF.new" && mv "$SELF.new" "$SELF"      # mv: the running copy is not overwritten in place
    # The new release's helper units (daily backups came in a later one than dashboard-updates on was run with);
    # only as root, which owns /etc/systemd. A folder owned by a user keeps its units until dashboard-updates on.
    if [[ $EUID -eq 0 && -f "$CTL/bridge.json" && -z "${SOLIS_TEST_MODE:-}" ]]; then "$SELF" dashboard-updates on >/dev/null 2>&1 || true; fi
    echo "Updated to $target."
    [[ -n "$(env_value CONTROL_TOKEN)" && -n "$(env_value INFLUX_READ_TOKEN)" ]] \
      || echo "The dashboard still reads the database with the admin token; give it a read-only one with: solis-monitor secure-tokens"
    refresh_bridge; report ok "Updated to $target"
    notify "🚀 Solis Monitor updated to $target"
  else
    echo "$target did not start properly; going back to $current." >&2
    restore "$current"
    compose up -d --remove-orphans
    report rolled_back "$target did not start properly, so $current was restored."
    notify "❌ Solis Monitor update to $target failed; still on $current"
    return 1
  fi
}

restore() {          # put the previous compose file and version back
  [[ -f docker-compose.yml.prev ]] && mv docker-compose.yml.prev docker-compose.yml
  set_env SOLIS_VERSION "$1"
}

healthy() {          # healthy NAME: the container's own healthcheck passes (an image without one: it is running)
  local h
  h="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$1" 2>/dev/null)"
  [[ "$h" == healthy ]] || { [[ "$h" == none && "$(docker inspect -f '{{.State.Running}}' "$1" 2>/dev/null)" == "true" ]]; }
}

wait_healthy() {     # the web and poller containers' healthchecks pass (the poller's is liveness only: an unreachable
                     # inverter never fails it, so a release is not rolled back because the logger is off) and the poller stays up
  local _ n=0 tries="${SOLIS_HEALTH_TRIES:-40}"
  for _ in $(seq 1 "$tries"); do
    n=$((n + 1))
    report running "Waiting for the new version to start" $((75 + 23 * n / tries))      # no-op unless the dashboard asked
    if healthy solis-web && healthy solis-poller; then
      sleep "${SOLIS_SETTLE_S:-10}"             # a crashing poller restarts within seconds
      [[ "$(docker inspect -f '{{.State.Running}}' solis-poller 2>/dev/null)" == "true" ]] && return 0
    fi
    sleep "${SOLIS_HEALTH_STEP:-5}"
  done
  return 1
}

# Settings the database only reads on its very first start: changing them in .env afterwards locks the
# poller and the dashboard out of InfluxDB. Compare .env with what the running container was created with.
locked_changes() {
  local pair name init have want changed=""
  for pair in INFLUX_TOKEN:ADMIN_TOKEN INFLUX_PASSWORD:PASSWORD INFLUX_USER:USERNAME INFLUX_ORG:ORG INFLUX_BUCKET:BUCKET; do
    name="${pair%%:*}"; init="DOCKER_INFLUXDB_INIT_${pair##*:}"
    have=$(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' solis-influxdb 2>/dev/null | sed -n "s/^${init}=//p" | sed -n 1p)
    want=$(env_value "$name")
    if [[ -n "$have" && "$have" != "$want" ]]; then changed="$changed $name"; fi
  done
  echo "${changed# }"
}

cmd_apply() {
  local force=""
  [[ "${1:-}" == "--force" ]] && force=1
  compose config -q 2>&1 || die ".env or docker-compose.yml has an error (see above); nothing was changed"
  local locked; locked="$(locked_changes)"
  if [[ -n "$locked" && -z "$force" ]]; then
    die "$locked only count on the database's very first start. Changing them now would lock the poller and the dashboard out of InfluxDB.
Put the old value(s) back in .env, or rotate the token properly (docs/advanced.md in the repository), or run with --force if you know what you are doing."
  fi
  chmod 600 .env
  ensure_ctl
  compose up -d --remove-orphans
  if wait_healthy; then
    echo "Applied: the dashboard is up and the poller is running."
  else
    echo "Applied, but the dashboard or the poller is not healthy yet. Look at: solis-monitor logs poller" >&2
    return 1
  fi
}

cmd_edit() {
  local editor="${SOLIS_EDITOR:-${VISUAL:-${EDITOR:-}}}" ans
  if [[ -z "$editor" ]]; then
    for editor in editor nano vi; do command -v "$editor" >/dev/null && break; done
  fi
  command -v "${editor%% *}" >/dev/null || die "no text editor found; set EDITOR (for example: EDITOR=nano solis-monitor edit)"
  backup="$(mktemp)"; cp .env "$backup"; trap 'rm -f "${backup:-}"' EXIT      # (global: the trap runs after this function)
  while :; do
    # shellcheck disable=SC2086   # the editor may carry options, e.g. "code --wait"
    $editor .env
    if cmp -s .env "$backup"; then echo "No changes."; return 0; fi
    if compose config -q 2>/dev/null; then break; fi
    compose config -q 2>&1 | sed -n 1,5p >&2 || true      # pipefail: the failing compose call is the point
    read -rp "That file has an error. Edit again? [Y/n] (n puts the old file back) " ans
    if [[ "${ans:-y}" == [nN]* ]]; then cp "$backup" .env; echo "Old .env restored."; return 1; fi
  done
  chmod 600 .env
  read -rp "Apply the changes now? [Y/n] " ans
  if [[ "${ans:-y}" == [nN]* ]]; then echo "Saved. Apply later with: solis-monitor apply"; return 0; fi
  cmd_apply || { read -rp "Put the previous .env back? [y/N] " ans; if [[ "${ans:-n}" == [yY]* ]]; then cp "$backup" .env && cmd_apply; fi; return 1; }
}

# The "Update" button on the dashboard's Settings page cannot run Docker (that container has no access to it).
# It drops a request file in control/; this path unit notices it and runs `update --from-dashboard` here on the host.
cmd_dashboard_updates() {
  local unit_dir="${SOLIS_UNIT_DIR:-/etc/systemd/system}" owner user_line=""
  owner="$(stat -c %U "$SELF")"
  if [[ "$owner" != root ]]; then user_line="User=$owner"; fi
  case "${1:-}" in
    on)
      [[ -n "$(env_value SOLIS_VERSION)" ]] || die "this copy was built from source; the dashboard can only update release installs"
      as_root install -d -o "$owner" -m 755 "$CTL"      # not left to Docker, which would create it as root
      as_root tee "$unit_dir/solis-monitor-dashboard-update.service" >/dev/null <<UNIT
[Unit]
Description=Update Solis Monitor (asked for on the dashboard)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
$user_line
ExecStart=$SELF update --from-dashboard
UNIT
      as_root tee "$unit_dir/solis-monitor-dashboard-update.path" >/dev/null <<UNIT
[Unit]
Description=Watch for update requests from the Solis Monitor dashboard

[Path]
PathChanged=$CTL/update-request
Unit=solis-monitor-dashboard-update.service

[Install]
WantedBy=multi-user.target
UNIT
      as_root install -d -o "$owner" -m 755 "$DIR/backups"
      as_root tee "$unit_dir/solis-monitor-dashboard-backup.service" >/dev/null <<UNIT
[Unit]
Description=Back up Solis Monitor (asked for on the dashboard)
After=docker.service

[Service]
Type=oneshot
$user_line
ExecStart=$SELF backup --from-dashboard
UNIT
      as_root tee "$unit_dir/solis-monitor-dashboard-backup.path" >/dev/null <<UNIT
[Unit]
Description=Watch for backup requests from the Solis Monitor dashboard

[Path]
PathChanged=$CTL/backup-request
Unit=solis-monitor-dashboard-backup.service

[Install]
WantedBy=multi-user.target
UNIT
      # Daily backups: every 15 minutes `backup --scheduled` looks whether the time set on the Backup tab has come
      # (so the page sets the time without touching systemd, and a machine that was off catches up when it starts).
      as_root tee "$unit_dir/solis-monitor-backup.service" >/dev/null <<UNIT
[Unit]
Description=Daily Solis Monitor backup (when its time, set on the dashboard, has come)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
$user_line
ExecStart=$SELF backup --scheduled
UNIT
      as_root tee "$unit_dir/solis-monitor-backup.timer" >/dev/null <<UNIT
[Unit]
Description=Look every 15 minutes whether the daily Solis Monitor backup is due

[Timer]
OnCalendar=*:0/15
OnBootSec=5min

[Install]
WantedBy=timers.target
UNIT
      # (written after the timer, so it says the timer is there; keeps the folder, count and time already chosen)
      write_backup_config "$(backup_dir)" "$(backup_keep)"; [[ -s "$CTL/backups.json" ]] || write_backup_index "$(backup_dir)"
      [[ "$owner" == root ]] || as_root chown "$owner" "$CTL/backup-config.json" "$CTL/backups.json" 2>/dev/null || true
      printf '{"enabled":true,"version":"%s","updated":"%s"}\n' "$(json_text "$(env_value SOLIS_VERSION)")" "$(now_iso)" | as_root -u "$owner" tee "$CTL/bridge.json" >/dev/null
      as_root systemctl daemon-reload
      as_root systemctl enable --now solis-monitor-dashboard-update.path solis-monitor-dashboard-backup.path solis-monitor-backup.timer
      echo "Updating and backing up from the dashboard are on: Settings -> System -> Software, Settings -> Backup (with daily backups, if you set a time there)." ;;
    off)
      as_root systemctl disable --now solis-monitor-dashboard-update.path solis-monitor-dashboard-backup.path solis-monitor-backup.timer 2>/dev/null || true
      rm -f "$CTL/bridge.json" "$CTL/update-request" "$CTL/backup-request"
      echo "Updating and backing up from the dashboard are off." ;;
    *) die "usage: solis-monitor dashboard-updates on|off" ;;
  esac
}

# A forgotten dashboard password: remove the one saved on the Settings page; the original (WEB_BASIC_AUTH in .env) applies again.
cmd_reset_login() {
  compose exec -T web rm -f /data/auth.json
  echo "The password saved on the Settings page is removed (a running dashboard notices at once)."
  echo "The original login applies again: $(env_value WEB_BASIC_AUTH | cut -d: -f1) and the password after the colon in WEB_BASIC_AUTH (solis-monitor edit)."
}

cmd_auto_update() {
  case "${1:-}" in
    on)
      # If this folder belongs to a normal user, the nightly job runs as that user, never as root: root would be
      # executing a script that user (or anything running as them) can edit. That user needs Docker access.
      local owner user_line=""
      owner="$(stat -c %U "$SELF")"
      if [[ "$owner" != root ]]; then user_line="User=$owner"; fi
      as_root tee ${SOLIS_UNIT_DIR:-/etc/systemd/system}/solis-monitor-update.service >/dev/null <<UNIT
[Unit]
Description=Update Solis Monitor to the latest release
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
$user_line
ExecStart=$SELF update --auto
UNIT
      as_root tee ${SOLIS_UNIT_DIR:-/etc/systemd/system}/solis-monitor-update.timer >/dev/null <<UNIT
[Unit]
Description=Look for a new Solis Monitor release every night

[Timer]
OnCalendar=*-*-* 04:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
UNIT
      as_root systemctl daemon-reload
      as_root systemctl enable --now solis-monitor-update.timer
      echo "Automatic updates are on: each night the latest tagged release is installed." ;;
    off)
      as_root systemctl disable --now solis-monitor-update.timer 2>/dev/null || true
      echo "Automatic updates are off. Update by hand with: solis-monitor update" ;;
    *) die "usage: solis-monitor auto-update on|off" ;;
  esac
}

case "${1:-}" in
  status) cmd_status ;;
  update) shift; cmd_update "$@" ;;
  auto-update) shift; cmd_auto_update "${1:-}" ;;
  logs) shift; follow=""; if [[ "${1:-}" == -f ]]; then follow=-f; shift; fi; compose logs ${follow:+"$follow"} --tail 100 "$@" ;;
  apply) shift; cmd_apply "${1:-}" ;;
  dashboard-updates) shift; cmd_dashboard_updates "${1:-}" ;;
  reset-login) cmd_reset_login ;;
  secure-tokens) cmd_secure_tokens ;;
  backup) shift; cmd_backup "$@" ;;
  restore) shift; cmd_restore "$@" ;;
  edit) cmd_edit ;;
  version) env_value SOLIS_VERSION ;;
  ""|-h|--help|help) sed -n '2,18p' "$SELF" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command '$1' (try: solis-monitor help)" ;;
esac
