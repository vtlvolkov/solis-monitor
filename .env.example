# Copy to .env and change the passwords/token before first start.
# Name of this installation. Shown as the dashboard title and in front of Telegram alerts, so two
# sites can share a chat. Empty = no name.
SITE_NAME=
INVERTER_HOST=          # IP of the data logger. Empty = enter it (or let the dashboard find it) on Settings -> General
INVERTER_PORT=502
MODBUS_UNIT=1
POLL_INTERVAL=10

INFLUX_USER=admin
INFLUX_PASSWORD=change-me-influx
INFLUX_ORG=home
INFLUX_BUCKET=solis
INFLUX_RETENTION=0          # keep 0: a retention on the whole bucket would also delete the outage history (use RAW_RETENTION_DAYS)
RAW_RETENTION_DAYS=90       # days of 10-second readings to keep (at least 35); older ones are deleted, the 1-minute aggregates, outages and settings log stay. 0 = keep all
INFLUX_BUCKET_1M=           # 1-minute aggregates for the long ranges, filled by an InfluxDB task the poller sets up; empty = <bucket>_1m
INFLUX_TOKEN=change-me-long-random-token
# Least privilege (both set by install.sh; on an older install run `solis-monitor secure-tokens` once):
# a read-only InfluxDB token for the dashboard, which never writes to the database (empty = it uses INFLUX_TOKEN),
# and the secret between the dashboard and the poller's internal API (empty = INFLUX_TOKEN is used for that too).
INFLUX_READ_TOKEN=
CONTROL_TOKEN=
# Backups (solis-monitor backup, Settings -> Backup) may go to a folder under /mnt, /media, /srv, /home, /opt, /var/backups,
# /backup(s) or /data. Other places for a mounted drive: list their roots here, separated by colons (e.g. /volume1/solis).
SOLIS_BACKUP_ROOTS=
TZ=Europe/Kyiv

# Host ports (Umbrel already uses some common ports)
WEB_PORT=8088
# HTTP Basic auth for the dashboard, user:pass. Empty = no auth (LAN only) and the
# Settings page is view-only. Changing settings requires this to be set.
WEB_BASIC_AUTH=
# true = the dashboard is open and the browser asks for the password only when you open Settings.
# Empty/false = the password is required for the whole site.
WEB_AUTH_SETTINGS_ONLY=

# --- Settings page: changing battery settings ---
# Stays OFF until you've verified CURRENT_SCALE (see README, "Settings").
CONTROL_ENABLED=false
CURRENT_SCALE=0.1                 # amps per raw unit of registers 43117/43118
MAX_CHARGE_CURRENT_A=0            # hard upper bound settable from the page; must not exceed your battery/BMS rating. 0 = refuse
MAX_DISCHARGE_CURRENT_A=0
MIN_WRITE_INTERVAL_S=60

# Usable battery capacity for the backup-runtime estimate. Empty = rated Ah from the
# inverter's battery setting (43019) x 51.2 V. A value saved on the Settings page
# (Battery tab) takes precedence over this one.
BATTERY_CAPACITY_KWH=

# Electricity tariff for the Overview's cost card (price per kWh). Empty TARIFF_DAY = card off.
# These are the prices before your first change: later changes are made on the Settings page and saved
# separately (past days keep their price), after which these values are no longer used.
# Two-zone meter: also set TARIFF_NIGHT and its hours.
TARIFF_CURRENCY=UAH
TARIFF_DAY=
TARIFF_NIGHT=
TARIFF_NIGHT_START=23:00
TARIFF_NIGHT_END=07:00

# Read-only MCP server for agents (Hermes) at http://<host>:8088/mcp. Empty = off.
# Its own token, not the dashboard password:  openssl rand -hex 32
MCP_TOKEN=

# MQTT, for Home Assistant, Node-RED or a smart relay: publishing only, nothing can reach the inverter this way.
# Easier on Settings -> System -> MQTT (that wins over these). Empty MQTT_HOST = off.
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_PREFIX=                      # topics start with it; empty = solis/<SITE_NAME>
MQTT_INTERVAL=10                  # seconds between readings: 10, 30 or 60 (outages and alarms go out at once)
MQTT_DISCOVERY=true               # Home Assistant discovery: the inverter appears there as a device
MQTT_DISCOVERY_PREFIX=homeassistant

# Telegram alerts (outages, battery levels during an outage, alarms, inverter offline, deploys).
# Can be the same bot Hermes uses. Chat ID = your Telegram user ID for a private chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_SOC_LEVELS=50,30,20
ALERT_OFFLINE_MIN=5
ALERT_CLOCK_DRIFT_MIN=5           # the inverter's clock this many minutes off -> one message (its daily totals depend on it); 0 = never

# --- Installer only (leave empty when building from source with `docker compose up -d --build`) ---
# Where the prebuilt images come from and which release is installed; install.sh sets both.
SOLIS_IMAGE_PREFIX=
SOLIS_VERSION=
SOLIS_REPO=               # GitHub owner/repo the installer's release updates come from
# How often (hours) the dashboard looks for a newer release to show the "Update available" badge. It asks
# api.github.com (sending only a normal HTTPS request with your IP address). 0 = never. Release installs only.
UPDATE_CHECK_HOURS=6
